# Copy to .env and fill in. Never commit .env.
#
# NOTE: an earlier revision of this repo committed live Alchemy keys in this file.
# They have been removed; if you forked before, rotate them — they are still in git history.

# JSON-RPC endpoints
ANVIL_RPC_URL='http://127.0.0.1:8545'
SEPOLIA_RPC_URL='https://sepolia.infura.io/v3/<your-key>'
BASE_SEPOLIA_RPC_URL='https://api.developer.coinbase.com/rpc/v1/base-sepolia/<your-cdp-token>'
MAINNET_RPC_URL='https://mainnet.infura.io/v3/<your-key>'

# Local deployer only. Anvil's default account #0, public knowledge by design.
# Live networks never read this — they sign through the Privy server wallet below.
DEPLOYER_PRIVATE_KEY='0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80'

# Privy server wallet, used for every live deployment and faucet transaction, so
# no deployer key exists on disk or in CI. The wallet must hold gas on the target
# chain. Same four values as the contracts package in fellow-monorepo.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_ADMIN_WALLET_ID=
PRIVY_ADMIN_WALLET_ADDRESS=
