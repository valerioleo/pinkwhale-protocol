# Copy to .env and fill in. Never commit .env.
#
# NOTE: an earlier revision of this repo committed live Alchemy keys in this file.
# They have been removed; if you forked before, rotate them — they are still in git history.

# JSON-RPC endpoints
ANVIL_RPC_URL='http://127.0.0.1:8545'
SEPOLIA_RPC_URL='https://sepolia.infura.io/v3/<your-key>'
BASE_SEPOLIA_RPC_URL='https://api.developer.coinbase.com/rpc/v1/base-sepolia/<your-cdp-token>'

# Coinbase Developer Platform. The Node and Paymaster endpoints are the same URL:
# paymaster methods are routed on it alongside the usual JSON-RPC.
# The project id is public by design — it is what the browser SDK initialises with.
# Every domain the site is served from has to be on the project's allowlists, for
# sign-in and for the node token in the browser, or both fail there and nowhere else.
CDP_PAYMASTER_URL='https://api.developer.coinbase.com/rpc/v1/base-sepolia/<your-cdp-token>'
NEXT_PUBLIC_CDP_PROJECT_ID=
MAINNET_RPC_URL='https://mainnet.infura.io/v3/<your-key>'

# Local deployer only. Anvil's default account #0, public knowledge by design.
# Live networks never read this — they sign through the CDP server account below.
DEPLOYER_PRIVATE_KEY='0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80'

# CDP server account, used for every live deployment and faucet transaction, so
# no deployer key exists on disk or in CI. A Secret API Key and a Wallet Secret from
# the CDP Portal, in the same project as NEXT_PUBLIC_CDP_PROJECT_ID. The faucet
# endpoint keeps the account in gas from CDP's testnet faucet.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=

