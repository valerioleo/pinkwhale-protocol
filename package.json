{
  "name": "@pinkwhale/contracts",
  "author": "Valerio Leo @valerioHQ",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "forge build",
    "test": "forge test",
    "test:e2e": "tsx test/e2e/loanLifecycle.ts",
    "mirror:images": "tsx scripts/assets/mirrorImages.ts",
    "generate": "deployoor generate",
    "anvil": "anvil --code-size-limit 40000",
    "deploy:anvil": "tsx scripts/deploy/index.ts --network anvil",
    "deploy:sepolia": "tsx scripts/deploy/index.ts --network sepolia",
    "deploy:base-sepolia": "tsx scripts/deploy/index.ts --network base-sepolia",
    "docs:og": "tsx scripts/og-image.ts",
    "docs:favicon": "tsx scripts/favicon.ts",
    "docs:dev": "cd docs && vocs dev",
    "docs:build": "cd docs && vocs build",
    "docs:preview": "cd docs && vocs preview",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@openzeppelin/contracts": "4.9.6",
    "@privy-io/node": "^0.8.0",
    "@shikijs/transformers": "3.23.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "deployoor": "^0.9.0",
    "dotenv": "^16.4.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "seaport-core": "1.6.6",
    "seaport-types": "1.6.3",
    "shiki": "^3.23.0",
    "solc": "^0.8.28",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "viem": "^2.21.55",
    "vite": "^8.2.1",
    "vocs": "^2.8.5",
    "waku": "1.0.0-beta.8"
  }
}
