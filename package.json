{
  "name": "@pinkwhale/contracts",
  "author": "Valerio Leo @valerioHQ",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "anvil": "anvil --code-size-limit 40000",
    "build": "forge build",
    "deploy:anvil": "tsx scripts/deploy/index.ts --network anvil",
    "deploy:base-sepolia": "tsx scripts/deploy/index.ts --network base-sepolia",
    "deploy:sepolia": "tsx scripts/deploy/index.ts --network sepolia",
    "dev": "pnpm --filter @pinkwhale/app dev",
    "docs:favicon": "tsx scripts/favicon.ts",
    "docs:og": "tsx scripts/og-image.ts",
    "generate": "deployoor generate",
    "site:build": "pnpm --filter @pinkwhale/app build",
    "test": "forge test",
    "test:e2e": "tsx test/e2e/loanLifecycle.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "4.9.6",
    "@privy-io/node": "^0.8.0",
    "@types/node": "^22.10.2",
    "deployoor": "^0.9.0",
    "dotenv": "^16.4.7",
    "seaport-core": "1.6.6",
    "seaport-types": "1.6.3",
    "solc": "^0.8.28",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "viem": "^2.21.55"
  }
}
