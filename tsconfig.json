{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "scripts/**/*.ts",
    "test/**/*.ts",
    "deployers/**/*.ts",
    "deployoor.config.ts",
    "docs/**/*.ts",
    "docs/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "out",
    "cache",
    "lib",
    "docs/dist"
  ]
}
